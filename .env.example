# API keys
YOUTUBE_API_KEY=your_youtube_api_key
GROQ_API_KEY=your_groq_api_key

# LLM and embedding providers
USE_LOCAL_LLM=false
USE_LOCAL_EMBEDDING_MODEL=true
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:1b
LLM_MODEL=openai/gpt-oss-20b
LLM_REQUEST_TIMEOUT_SECONDS=60

# Storage
CHROMA_PERSIST_DIR=./data/vectorstore
RAW_DATA_DIR=./data/raw

# Ingestion limits
MAX_COMMENTS_PER_VIDEO=100
MAX_VIDEOS_PER_CHANNEL=10

# Application
APP_ENV=production
LOG_LEVEL=INFO

# Backend CORS: use the deployed Vercel origin in production.
FRONTEND_URL=http://localhost:5173

# Hugging Face Spaces overrides (set these in the Space, not for local development).
# FRONTEND_URL=https://tube-insight-ai-puce.vercel.app
# CHROMA_PERSIST_DIR=/data/vectorstore
# RAW_DATA_DIR=/data/raw